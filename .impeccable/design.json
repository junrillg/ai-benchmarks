      "html": "<button class=\"ds-view ds-view-selected\" type=\"button\" aria-pressed=\"true\">Score vs. cost</button>",
      "css": ".ds-view{font-family:'Geist',sans-serif;height:35px;border:1px solid #b7cde6;background:#f5f9fe;border-radius:4px;padding:0 19px;font-size:14px;color:var(--ink);cursor:pointer}.ds-view:hover{filter:brightness(.95)}.ds-view:focus-visible{outline:2px solid var(--blue);outline-offset:3px}.ds-view-selected{background:var(--blue);color:white;border-color:var(--blue)}"
